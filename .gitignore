# 编译中间产物
app/build/
app/gen/
app/classes/
app/dexout/
app/res.zip
app/*.apk
app/*.aligned.apk
app/*withdex.apk
app/*.unsigned.apk

# 工具链与本地文件
tools/
android_sdk/
platform-tools/
*.log
.DS_Store

# 守护器运行数据（状态可随时生成，流水日志体积大不入库）
data/watchdog.log
data/watchdog.lock
data/state.env
data/status.txt
data/cron.log

# apksigner v4 签名附属文件
dist/*.idsig

# child-guard/reminder 构建中间产物（保留 reminder.apk 与签名证书）
child-guard/reminder/classes/
child-guard/reminder/dexout/
child-guard/reminder/gen/
child-guard/reminder/res.zip
child-guard/reminder/*-unsigned.apk
child-guard/reminder/*-withdex.apk
child-guard/reminder/*-aligned.apk
child-guard/reminder/*.idsig
